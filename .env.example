# Sika backend — required environment variables
# Copy to .env for local dev; set these in your host's dashboard for production.

# PostgreSQL connection string.
# Hosted (Neon/Render/etc.) connections use SSL automatically; localhost does not.
DATABASE_URL=postgres://user:password@localhost:5432/sika

# Secret used to sign JWTs. MUST be set — the API cannot issue or verify tokens without it.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional — sensible defaults are applied if omitted.
JWT_EXPIRES_IN=7d
PORT=4000
CORS_ORIGIN=*
